# ─── Supabase (required) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server only. Never prefix this one with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Stripe (subscriptions and paid downloads) ─────────────────────
STRIPE_SECRET_KEY=sk_live_...
# From the webhook endpoint you create at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Test payments ─────────────────────────────────────────────────────────
# Set both to 1 to activate plans straight away with no card and no Stripe
# round trip. Ignored if STRIPE_SECRET_KEY is a live key. Leave unset in
# production once real payments are on.
MOCK_PAYMENTS=
NEXT_PUBLIC_MOCK_PAYMENTS=

# Used to build Stripe return URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://livefromleonida.com
GOOGLE_SITE_VERIFICATION=

# ─── Email (Resend) ────────────────────────────────────────────────────────
# API key from resend.com for the verified sending domain.
RESEND_API_KEY=re_...
# Must be a sender on that verified domain.
EMAIL_FROM=Live From Leonida <noreply@livefromleonida.com>
# Any long random string. The database pings /api/email/flush with it so the
# outbox goes out; the route refuses anything that doesn't match.
EMAIL_FLUSH_SECRET=
# From Supabase: Authentication > Hooks > Send Email hook > Generate secret.
# Paste it whole, "v1,whsec_" prefix and all. Without this every auth email
# is rejected as unsigned, so add it and redeploy BEFORE enabling the hook.
SEND_EMAIL_HOOK_SECRET=
